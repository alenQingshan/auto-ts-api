{
  "openapi": "3.0.0",
  "info": {
    "title": "Standard API Documentation",
    "description": "通用标准 API 接口文档",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@example.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "开发环境"
    },
    {
      "url": "https://api.example.com/v1",
      "description": "生产环境"
    }
  ],
  "tags": [
    {
      "name": "Users",
      "description": "用户管理"
